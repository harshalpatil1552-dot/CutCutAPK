<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Salon"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Salon.SalonSettings.SalonSettingsPage"
             x:DataType="viewModels:SalonSettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24" Spacing="0">

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Salon settings" Style="{StaticResource AuthHeroTitle}" />
                        <Label Text="Update your salon's details. Turning it off hides it from customer search." Style="{StaticResource PageSubtitle}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="Log out" Style="{StaticResource AuthInlineLink}" VerticalOptions="Start">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource AlertErrorBorder}"
                        Margin="0,0,0,18"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                </Border>

                <Border Style="{StaticResource AlertSuccessBorder}"
                        Margin="0,0,0,18"
                        IsVisible="{Binding InfoMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding InfoMessage}" Style="{StaticResource AlertSuccessText}" />
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Salon name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource CreamFieldEntryBorder}">
                                <Entry Text="{Binding Name}" Style="{StaticResource CreamFieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Address" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource CreamFieldEntryBorder}">
                                <Entry Text="{Binding AddressLine}" Style="{StaticResource CreamFieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="City" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource CreamFieldEntryBorder}">
                                <Entry Text="{Binding City}" Style="{StaticResource CreamFieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Opens" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource CreamFieldEntryBorder}">
                                    <TimePicker Time="{Binding OpeningTime}" Style="{StaticResource FieldTimePicker}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Closes" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource CreamFieldEntryBorder}">
                                    <TimePicker Time="{Binding ClosingTime}" Style="{StaticResource FieldTimePicker}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding IsActive}" OnColor="{StaticResource AuthGold}" />
                            <Label Text="Accepting bookings" Style="{StaticResource FieldLabel}" VerticalOptions="Center" FontAttributes="None" />
                        </HorizontalStackLayout>

                        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Save changes|Saving…'}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource AuthGoldButton}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
