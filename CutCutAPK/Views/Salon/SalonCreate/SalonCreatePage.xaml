<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Salon"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Salon.SalonCreate.SalonCreatePage"
             x:DataType="viewModels:SalonCreateViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- app-header: brand + logout only, matching the web app's salon-create rendering its
             own bare app-header (this page sits outside the salon-shell nav). -->
        <Grid Grid.Row="0" RowDefinitions="Auto,1" BackgroundColor="{StaticResource BrandSurface}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="12">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Border Style="{StaticResource AuthBrandMark}">
                        <Label Text="CC" Style="{StaticResource AuthBrandMarkText}" />
                    </Border>
                    <Label Text="CutCut for Salons" Style="{StaticResource AuthBrandName}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="Log out" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" />
            </Grid>
            <BoxView Grid.Row="1" Color="{StaticResource BrandBorder}" HeightRequest="1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="0" MaximumWidthRequest="480" HorizontalOptions="Center">

                <Label Text="Create your salon" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                <Label Text="You'll be able to add services and staff right after." Style="{StaticResource PageSubtitle}" Margin="0,0,0,20" />

                <Border Style="{StaticResource AlertErrorBorder}"
                        Margin="0,0,0,18"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Salon name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <Entry Text="{Binding Name}" Placeholder="CutCut Salon" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Address" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <Entry Text="{Binding AddressLine}" Placeholder="123 MG Road" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="City" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <Entry Text="{Binding City}" Placeholder="Pune" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Opens" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldEntryBorder}">
                                    <TimePicker Time="{Binding OpeningTime}" Style="{StaticResource FieldTimePicker}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Closes" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldEntryBorder}">
                                    <TimePicker Time="{Binding ClosingTime}" Style="{StaticResource FieldTimePicker}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Create salon|Creating…'}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
