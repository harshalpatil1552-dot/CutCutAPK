<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Salon"
             xmlns:catalog="clr-namespace:CutCutAPK.Models.Catalog"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Salon.SalonServices.SalonServicesPage"
             x:Name="Root"
             x:DataType="viewModels:SalonServicesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
        <converters:IsNotBusyIdConverter x:Key="IsNotBusyIdConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24" Spacing="0">

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Services" Style="{StaticResource AuthHeroTitle}" Margin="0,0,0,2" />
                        <Label Text="What customers can book at your salon." Style="{StaticResource PageSubtitle}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="Log out" Style="{StaticResource AuthInlineLink}" VerticalOptions="Start">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource AlertErrorBorder}"
                        Margin="0,0,0,16"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                </Border>

                <!-- Add-service form -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Add a service" Style="{StaticResource CardTitle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Name" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource CreamFieldEntryBorder}">
                                    <Entry Text="{Binding NewServiceName}" Placeholder="Haircut" Style="{StaticResource CreamFieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Duration (minutes)" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource CreamFieldEntryBorder}">
                                    <Entry Text="{Binding NewServiceDurationMinutes}" Keyboard="Numeric" Style="{StaticResource CreamFieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6" MaximumWidthRequest="200" HorizontalOptions="Start">
                            <Label Text="Price (₹)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource CreamFieldEntryBorder}">
                                <Entry Text="{Binding NewServicePrice}" Keyboard="Numeric" Style="{StaticResource CreamFieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Add service|Adding…'}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SmallGoldButton}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Loading services…" Style="{StaticResource LoadingLabel}" IsVisible="{Binding IsLoading}" />

                <CollectionView ItemsSource="{Binding Services}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ServiceResponseDto">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                        <HorizontalStackLayout Spacing="14">
                                            <Label Style="{StaticResource CardMeta}">
                                                <Label.Text>
                                                    <Binding Path="DurationMinutes" StringFormat="{}{0} min" />
                                                </Label.Text>
                                            </Label>
                                            <Label Style="{StaticResource CardMeta}">
                                                <Label.Text>
                                                    <Binding Path="Price" StringFormat="₹{0}" />
                                                </Label.Text>
                                            </Label>
                                            <Label Style="{StaticResource CardMeta}"
                                                   Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Inactive|Active'}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SmallButtonOutline}"
                                            VerticalOptions="Center"
                                            Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Activate|Deactivate'}"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleActiveCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource AuthGold}" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderWidth" Value="0" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource IsNotBusyIdConverter}">
                                                <Binding Source="{x:Reference Root}" Path="BindingContext.BusyServiceId" />
                                                <Binding Path="ServiceId" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
