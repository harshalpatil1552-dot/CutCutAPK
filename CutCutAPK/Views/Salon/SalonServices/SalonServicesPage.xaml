<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Salon"
             xmlns:catalog="clr-namespace:CutCutAPK.Models.Catalog"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Salon.SalonServices.SalonServicesPage"
             x:Name="Root"
             x:DataType="viewModels:SalonServicesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
        <converters:IsNotBusyIdConverter x:Key="IsNotBusyIdConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- app-header -->
        <Grid Grid.Row="0" RowDefinitions="Auto,1" BackgroundColor="{StaticResource BrandSurface}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,14" ColumnSpacing="12">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Border Style="{StaticResource AuthBrandMark}">
                        <Label Text="CC" Style="{StaticResource AuthBrandMarkText}" />
                    </Border>
                    <Label Text="CutCut for Salons" Style="{StaticResource AuthBrandName}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Start">
                    <Button Text="Today" Style="{StaticResource HeaderNavButton}" Command="{Binding GoToTodayCommand}" />
                    <Button Text="Services" Style="{StaticResource HeaderNavButtonActive}" Command="{Binding GoToServicesCommand}" IsVisible="{Binding IsOwner}" />
                    <Button Text="Staff" Style="{StaticResource HeaderNavButton}" Command="{Binding GoToStaffCommand}" IsVisible="{Binding IsOwner}" />
                    <Button Text="Settings" Style="{StaticResource HeaderNavButton}" Command="{Binding GoToSettingsCommand}" IsVisible="{Binding IsOwner}" />
                </HorizontalStackLayout>
                <Button Grid.Column="2" Text="Log out" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" />
            </Grid>
            <BoxView Grid.Row="1" Color="{StaticResource BrandBorder}" HeightRequest="1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="0">

                <Label Text="Services" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                <Label Text="What customers can book at your salon." Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />

                <Border Style="{StaticResource AlertErrorBorder}"
                        Margin="0,0,0,16"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                </Border>

                <!-- Add-service form -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Add a service" Style="{StaticResource CardTitle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Name" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldEntryBorder}">
                                    <Entry Text="{Binding NewServiceName}" Placeholder="Haircut" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Duration (minutes)" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldEntryBorder}">
                                    <Entry Text="{Binding NewServiceDurationMinutes}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6" MaximumWidthRequest="200" HorizontalOptions="Start">
                            <Label Text="Price (₹)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <Entry Text="{Binding NewServicePrice}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Add service|Adding…'}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SmallButtonPrimary}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Loading services…" Style="{StaticResource LoadingLabel}" IsVisible="{Binding IsLoading}" />

                <CollectionView ItemsSource="{Binding Services}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ServiceResponseDto">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                        <HorizontalStackLayout Spacing="14">
                                            <Label Style="{StaticResource CardMeta}">
                                                <Label.Text>
                                                    <Binding Path="DurationMinutes" StringFormat="{}{0} min" />
                                                </Label.Text>
                                            </Label>
                                            <Label Style="{StaticResource CardMeta}">
                                                <Label.Text>
                                                    <Binding Path="Price" StringFormat="₹{0}" />
                                                </Label.Text>
                                            </Label>
                                            <Label Style="{StaticResource CardMeta}"
                                                   Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Inactive|Active'}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SmallButtonOutline}"
                                            VerticalOptions="Center"
                                            Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Activate|Deactivate'}"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleActiveCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderWidth" Value="0" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource IsNotBusyIdConverter}">
                                                <Binding Source="{x:Reference Root}" Path="BindingContext.BusyServiceId" />
                                                <Binding Path="ServiceId" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
