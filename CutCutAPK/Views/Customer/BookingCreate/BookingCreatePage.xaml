<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Customer"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Customer.BookingCreate.BookingCreatePage"
             x:Name="Root"
             x:DataType="viewModels:BookingCreateViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="&#8592; Back" Style="{StaticResource BackLink}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Choose a time" Style="{StaticResource AuthHeroTitle}" />

            <Border Style="{StaticResource AlertErrorBorder}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
            </Border>

            <!-- Service -->
            <Border Style="{StaticResource CardBorder}"
                    IsVisible="{Binding Service, Converter={StaticResource IsNotNullConverter}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CardIconBadge}">
                        <Image Source="badge_scissors.svg" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Service" Style="{StaticResource CardMeta}" />
                        <Label Style="{StaticResource CardTitle}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} · {1} min · ₹{2}">
                                    <Binding Path="Service.Name" />
                                    <Binding Path="Service.DurationMinutes" />
                                    <Binding Path="Service.Price" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Date strip -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource CardIconBadge}">
                            <Image Source="badge_calendar.svg" />
                        </Border>
                        <Label Grid.Column="1" Text="Date" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8"
                                               BindableLayout.ItemsSource="{Binding AvailableDates}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:BookingDateOption">
                                    <Border Style="{StaticResource DatePillBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectDateCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DayNumber}" Style="{StaticResource DatePillNumber}" />
                                            <Label Text="{Binding DayName}" Style="{StaticResource DatePillName}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Available time slots -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource CardIconBadge}">
                            <Image Source="badge_clock.svg" />
                        </Border>
                        <Label Grid.Column="1" Text="Available time slots" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Loading times…" Style="{StaticResource LoadingLabel}" IsVisible="{Binding IsLoadingSlots}" />

                    <Label Text="No slots available on this day." Style="{StaticResource CardSubtitle}"
                           IsVisible="{Binding ShowNoSlotsState}" />

                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Slots}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BookingSlotOption">
                                <Border Style="{StaticResource SlotPillBorder}" Margin="0,0,8,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectSlotCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding DisplayTime}" Style="{StaticResource SlotPillText}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                        <HorizontalStackLayout Spacing="5">
                            <Ellipse Style="{StaticResource SlotLegendDot}" Fill="{StaticResource BrandSuccess}" />
                            <Label Text="Available" Style="{StaticResource SlotLegendText}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Ellipse Style="{StaticResource SlotLegendDot}" Fill="{StaticResource BrandPrimary}" />
                            <Label Text="Selected" Style="{StaticResource SlotLegendText}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Ellipse Style="{StaticResource SlotLegendDot}" Fill="{StaticResource Gray200}" />
                            <Label Text="Booked" Style="{StaticResource SlotLegendText}" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SubmitButtonText}"
                    Command="{Binding SubmitCommand}"
                    Style="{StaticResource AuthGoldButton}"
                    Margin="0,6,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
