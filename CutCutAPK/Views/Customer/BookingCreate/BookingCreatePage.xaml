<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Customer"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             x:Class="CutCutAPK.Views.Customer.BookingCreate.BookingCreatePage"
             x:DataType="viewModels:BookingCreateViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- app-header: same nav block as every other customer-area screen. -->
        <Grid Grid.Row="0" RowDefinitions="Auto,1" BackgroundColor="{StaticResource BrandSurface}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,14" ColumnSpacing="12">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Border Style="{StaticResource AuthBrandMark}">
                        <Label Text="CC" Style="{StaticResource AuthBrandMarkText}" />
                    </Border>
                    <Label Text="CutCut" Style="{StaticResource AuthBrandName}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Start">
                    <Button Text="Find a salon" Style="{StaticResource HeaderNavButton}" Command="{Binding GoToSalonSearchCommand}" />
                    <Button Text="My bookings" Style="{StaticResource HeaderNavButton}" Command="{Binding GoToMyBookingsCommand}" />
                </HorizontalStackLayout>
                <Button Grid.Column="2" Text="Log out" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" />
            </Grid>
            <BoxView Grid.Row="1" Color="{StaticResource BrandBorder}" HeightRequest="1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="0" MaximumWidthRequest="480" HorizontalOptions="Center">

                <!-- page-heading -->
                <Label Text="Choose a time" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                <Label Style="{StaticResource PageSubtitle}"
                       Margin="0,0,0,20"
                       IsVisible="{Binding Service, Converter={StaticResource IsNotNullConverter}}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0} · {1} min · ₹{2}">
                            <Binding Path="Service.Name" />
                            <Binding Path="Service.DurationMinutes" />
                            <Binding Path="Service.Price" />
                        </MultiBinding>
                    </Label.Text>
                </Label>

                <Border Style="{StaticResource AlertErrorBorder}"
                        Margin="0,0,0,18"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                </Border>

                <!-- card: date + time form-fields, mirroring booking-create.html's two <input>s. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <DatePicker Date="{Binding SelectedDate}" Style="{StaticResource FieldDatePicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Time" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldEntryBorder}">
                                <TimePicker Time="{Binding SelectedTime}" Style="{StaticResource FieldTimePicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Confirm slot|Booking…'}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
