<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CutCutAPK.ViewModels.Customer"
             xmlns:bookings="clr-namespace:CutCutAPK.Models.Bookings"
             xmlns:converters="clr-namespace:CutCutAPK.Common.Converters"
             xmlns:shared="clr-namespace:CutCutAPK.Views.Shared"
             x:Class="CutCutAPK.Views.Customer.MyBookings.MyBookingsPage"
             x:Name="Root"
             x:DataType="viewModels:MyBookingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ContentPage.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="HasTextConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="My bookings" Style="{StaticResource AuthHeroTitle}" />
                    <Label Text="Everything you've booked, from pending payment through to completed." Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                    <Button Text="+ New booking"
                            Style="{StaticResource SmallGoldButton}"
                            HorizontalOptions="End"
                            Command="{Binding GoToSalonSearchCommand}" />
                    <Label Text="Log out" Style="{StaticResource AuthInlineLink}" HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource AlertErrorBorder}"
                    Margin="0,0,0,16"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource HasTextConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
            </Border>

            <Label Text="Loading your bookings…" Style="{StaticResource LoadingLabel}" IsVisible="{Binding IsLoading}" />

            <Border Style="{StaticResource CreamEmptyStateBorder}" IsVisible="{Binding ShowEmptyState}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="No bookings yet" Style="{StaticResource EmptyStateTitle}" />
                    <Label Text="Find a salon and book your first appointment." Style="{StaticResource EmptyStateSubtitle}" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Bookings}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="bookings:BookingResponseDto">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenBookingCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource CardTitle}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} at {1}">
                                                <Binding Path="ServiceName" />
                                                <Binding Path="SalonName" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <HorizontalStackLayout Spacing="14">
                                        <Label Style="{StaticResource CardMeta}">
                                            <Label.Text>
                                                <Binding Path="SlotStartTimeUtc" StringFormat="{}{0:MMM d, yyyy h:mm tt}" />
                                            </Label.Text>
                                        </Label>
                                        <Label Style="{StaticResource CardMeta}">
                                            <Label.Text>
                                                <Binding Path="Amount" StringFormat="₹{0}" />
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <shared:StatusBadgeView Grid.Column="1" StatusId="{Binding BookingStatusId}" VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
